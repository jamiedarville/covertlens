{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://covertlens.dev/schemas/route-trace-audit.schema.json",
  "title": "CovertLens artifact route and trace coverage audit (CL-32)",
  "type": "object",
  "required": ["schema", "routes", "routes_failed", "coverage", "trace", "gaps"],
  "properties": {
    "schema": {"const": "covertlens.route-trace-audit"},
    "routes": {
      "type": "array",
      "minItems": 8,
      "items": {
        "type": "object",
        "required": ["route_id", "status", "checks"],
        "properties": {
          "status": {"enum": ["pass", "partial", "failed", "exempt_verified"]}
        }
      }
    },
    "routes_failed": {"type": "array", "maxItems": 0},
    "trace": {
      "type": "object",
      "required": ["all_missing_explained", "missing_link_reasons"],
      "properties": {"all_missing_explained": {"const": true}}
    },
    "full_coverage_claimed": {"const": false},
    "equated_with_collusion": {"const": false}
  }
}
