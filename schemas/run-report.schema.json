{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://covertlens.internal/schemas/run-report.schema.json",
  "title": "CovertLens researcher run report (CL-25)",
  "type": "object",
  "required": [
    "schema", "schema_version", "report_version", "report_id", "run_id",
    "causation_claimed", "evidence_aid_label", "originals", "deliveries",
    "timeline", "prior_context", "actions", "triage_queue", "reviews",
    "disposition_counts"
  ],
  "properties": {
    "schema": {"const": "covertlens.run-report"},
    "schema_version": {"type": "integer", "minimum": 1},
    "report_version": {"type": "string", "minLength": 1},
    "report_id": {"type": ["string", "null"]},
    "run_id": {"type": "string", "minLength": 1},
    "causation_claimed": {"const": false},
    "evidence_aid_label": {"const": "evidence_aid_not_decoded_message"},
    "originals": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["artifact_id", "artifact_version_id", "content_hash", "findings", "evidence_aids"],
        "properties": {
          "content_hash": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
          "evidence_aids": {
            "type": "array",
            "items": {
              "type": "object",
              "required": ["family", "detector", "score", "bar", "label"],
              "properties": {
                "score": {"type": "number", "minimum": 0, "maximum": 1},
                "label": {"const": "evidence_aid_not_decoded_message"}
              }
            }
          }
        }
      }
    },
    "deliveries": {"type": "array"},
    "timeline": {"type": "array"},
    "prior_context": {
      "type": "object",
      "required": ["participants", "episodes"]
    },
    "actions": {"type": "array"},
    "triage_queue": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["delivery_id", "max_score", "disposition"],
        "properties": {
          "disposition": {
            "enum": ["benign", "unresolved", "suspected", "demonstrated_transfer", "policy_supported"]
          }
        }
      }
    },
    "reviews": {"type": "object"},
    "disposition_counts": {
      "type": "object",
      "required": ["benign", "unresolved", "suspected", "demonstrated_transfer", "policy_supported"]
    }
  }
}
