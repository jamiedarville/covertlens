{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://covertlens.internal/schemas/split-manifest.schema.json",
  "title": "CovertLens leakage-safe split manifest (CL-10)",
  "type": "object",
  "required": ["schema", "version", "policy", "assignments", "held_out", "leakage_errors"],
  "properties": {
    "schema": {"const": "covertlens.split-manifest"},
    "version": {"type": "integer", "minimum": 1},
    "policy": {
      "type": "object",
      "required": ["version", "dataset_seed", "ratios"],
      "properties": {
        "version": {"type": "string"},
        "dataset_seed": {"type": "integer"},
        "ratios": {
          "type": "object",
          "required": ["train", "calibration", "held_out"],
          "properties": {
            "train": {"type": "number", "minimum": 0, "maximum": 1},
            "calibration": {"type": "number", "minimum": 0, "maximum": 1},
            "held_out": {"type": "number", "minimum": 0, "maximum": 1}
          }
        }
      }
    },
    "assignments": {
      "type": "object",
      "additionalProperties": {"enum": ["train", "calibration", "held_out"]}
    },
    "held_out": {
      "type": "object",
      "required": ["fixture_count", "fixture_ids", "cover_seeds", "patterns", "encoder_configs"],
      "properties": {
        "fixture_count": {"type": "integer", "minimum": 0},
        "fixture_ids": {"type": "array", "items": {"type": "string"}},
        "cover_seeds": {"type": "array", "items": {"type": "integer"}},
        "payload_seeds": {"type": "array", "items": {"type": "integer"}},
        "patterns": {"type": "array", "items": {"type": "string"}},
        "encoder_configs": {"type": "array", "items": {"type": "object"}},
        "tasks": {"type": "array"},
        "agents": {"type": "array"}
      }
    },
    "leakage_errors": {"type": "array", "items": {"type": "string"}}
  }
}
