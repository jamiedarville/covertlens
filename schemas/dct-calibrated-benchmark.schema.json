{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://covertlens.internal/schemas/dct-calibrated-benchmark.schema.json",
  "title": "CovertLens DCT calibrated-histogram benchmark report (CL-61)",
  "type": "object",
  "required": [
    "schema", "schema_version", "benchmark_version", "detector",
    "comparator", "thresholds_status", "fixture_count", "scored_count",
    "skipped_non_dct", "positive_count", "negative_count", "rows",
    "by_payload_band", "calibrated_roc_auc", "pov_roc_auc",
    "calibrated_beats_pov", "limitations"
  ],
  "properties": {
    "schema": {"const": "covertlens.dct-calibrated-benchmark"},
    "schema_version": {"type": "integer", "minimum": 1},
    "benchmark_version": {"type": "string", "minLength": 1},
    "detector": {
      "type": "object",
      "required": ["family", "name", "version", "config"],
      "properties": {
        "family": {"const": "jpeg_dct"},
        "name": {"const": "dct-calibrated-histogram"},
        "version": {"type": "string", "minLength": 1},
        "config": {
          "type": "object",
          "required": ["version", "tv_reference", "neighbor_agreement_min", "score_cap"],
          "properties": {
            "version": {"type": "string", "minLength": 1},
            "tv_reference": {"type": "number", "exclusiveMinimum": 0},
            "neighbor_agreement_min": {"type": "number", "minimum": 0, "maximum": 1},
            "score_cap": {"type": "number", "exclusiveMinimum": 0, "maximum": 1}
          }
        }
      }
    },
    "comparator": {
      "type": "object",
      "required": ["family", "name", "version"],
      "properties": {
        "family": {"const": "jpeg_dct"},
        "name": {"const": "dct-coefficient-pov-chisquare"},
        "version": {"type": "string", "minLength": 1}
      }
    },
    "thresholds_status": {"const": "unfrozen_placeholder"},
    "fixture_count": {"type": "integer", "minimum": 0},
    "scored_count": {"type": "integer", "minimum": 0},
    "skipped_non_dct": {"type": "integer", "minimum": 0},
    "positive_count": {"type": "integer", "minimum": 0},
    "negative_count": {"type": "integer", "minimum": 0},
    "rows": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "fixture_id", "role", "label", "payload_band", "payload_bits",
          "bits_per_pixel", "applicable", "calibrated_score", "pov_score"
        ],
        "properties": {
          "fixture_id": {"type": "string"},
          "role": {"enum": ["clean", "encoded", "negative"]},
          "label": {"enum": [0, 1]},
          "payload_band": {"enum": ["none", "low", "medium", "high"]},
          "payload_bits": {"type": "integer", "minimum": 0},
          "bits_per_pixel": {"type": "number", "minimum": 0},
          "applicable": {"type": "boolean"},
          "calibrated_score": {"type": ["number", "null"], "minimum": 0, "maximum": 1},
          "pov_score": {"type": ["number", "null"], "minimum": 0, "maximum": 1}
        }
      }
    },
    "by_payload_band": {
      "type": "object",
      "required": ["none", "low", "medium", "high"],
      "properties": {
        "none": {"$ref": "#/$defs/band"},
        "low": {"$ref": "#/$defs/band"},
        "medium": {"$ref": "#/$defs/band"},
        "high": {"$ref": "#/$defs/band"}
      }
    },
    "calibrated_roc_auc": {"$ref": "#/$defs/metric"},
    "pov_roc_auc": {"$ref": "#/$defs/metric"},
    "calibrated_beats_pov": {"type": "boolean"},
    "limitations": {"type": "array", "items": {"type": "string"}}
  },
  "$defs": {
    "band": {
      "type": "object",
      "required": [
        "fixture_count", "positive_count", "negative_count",
        "scores", "roc_auc_vs_negatives"
      ],
      "properties": {
        "fixture_count": {"type": "integer", "minimum": 0},
        "positive_count": {"type": "integer", "minimum": 0},
        "negative_count": {"type": "integer", "minimum": 0},
        "scores": {
          "type": "object",
          "required": ["count", "min", "max", "mean"],
          "properties": {
            "count": {"type": "integer", "minimum": 0},
            "min": {"type": ["number", "null"]},
            "max": {"type": ["number", "null"]},
            "mean": {"type": ["number", "null"]}
          }
        },
        "roc_auc_vs_negatives": {"type": ["number", "null"], "minimum": 0, "maximum": 1}
      }
    },
    "metric": {
      "type": "object",
      "required": [
        "estimate", "ci_low", "ci_high",
        "bootstrap_replicates", "bootstrap_seed"
      ],
      "properties": {
        "estimate": {"type": ["number", "null"], "minimum": 0, "maximum": 1},
        "ci_low": {"type": ["number", "null"], "minimum": 0, "maximum": 1},
        "ci_high": {"type": ["number", "null"], "minimum": 0, "maximum": 1},
        "bootstrap_replicates": {"type": "integer", "minimum": 0},
        "bootstrap_seed": {"type": "integer"}
      }
    }
  }
}
