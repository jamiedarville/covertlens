{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://covertlens.dev/schemas/robustness-evaluation.schema.json",
  "title": "CovertLens adaptive and unseen-configuration evaluation (CL-34)",
  "type": "object",
  "required": ["schema", "frozen_config_version", "experiments", "outcomes",
               "coverage_limitations", "unresolved"],
  "properties": {
    "schema": {"const": "covertlens.robustness-evaluation"},
    "separate_from_frozen_benchmark": {"const": true},
    "merged_into_frozen_claim": {"const": false},
    "experiments": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["name", "kind", "attempts", "controls", "outcome"],
        "properties": {
          "kind": {"enum": ["adaptive", "unseen_configuration", "low_signal_sequence"]},
          "outcome": {"enum": ["detected", "evaded", "evaded_below_enforcement",
                               "mixed", "confounded_unresolved"]}
        }
      }
    },
    "unresolved": {"type": "array", "minItems": 1},
    "equated_with_collusion": {"const": false}
  }
}
