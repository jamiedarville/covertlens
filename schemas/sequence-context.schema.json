{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://covertlens.internal/schemas/sequence-context.schema.json",
  "title": "CovertLens episode sequence context (CL-24)",
  "type": "object",
  "required": [
    "schema", "schema_version", "sequence_version", "run_id",
    "causation_claimed", "deliveries", "actions", "participants", "episodes"
  ],
  "properties": {
    "schema": {"const": "covertlens.sequence-context"},
    "schema_version": {"type": "integer", "minimum": 1},
    "sequence_version": {"type": "string", "minLength": 1},
    "run_id": {"type": "string", "minLength": 1},
    "causation_claimed": {"const": false},
    "deliveries": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "delivery_id", "artifact_version_id", "content_hash",
          "episode_id", "sender_id", "recipient_id", "attempted_seq",
          "delivered", "max_score", "family_scores"
        ],
        "properties": {
          "max_score": {"type": "number", "minimum": 0, "maximum": 1},
          "attempted_seq": {"type": "integer", "minimum": 0},
          "delivered": {"type": "boolean"}
        }
      }
    },
    "actions": {"type": "array"},
    "participants": {"type": "object"},
    "episodes": {"type": "object"}
  }
}
