{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://covertlens.dev/schemas/leaderboard-entry.schema.json",
  "title": "CovertLens leaderboard entry: one encoder submission scored under a pinned configuration (CL-70)",
  "type": "object",
  "required": ["schema", "entry_id", "pin_hash", "detectors", "threshold_config_version",
               "submitted_at", "submitter", "encoder", "artifact", "outcome", "status",
               "moderation", "equated_with_collusion"],
  "properties": {
    "schema": {"const": "covertlens.leaderboard-entry"},
    "entry_id": {"type": "string", "pattern": "^lb_[0-9a-f]+$"},
    "pin_hash": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "detectors": {"type": "array", "minItems": 1, "items": {"type": "string"}},
    "threshold_config_version": {"type": "string"},
    "submitter": {
      "type": "object",
      "required": ["display_name"],
      "properties": {"display_name": {"type": "string", "maxLength": 40}}
    },
    "encoder": {
      "type": "object",
      "required": ["kind"],
      "not": {"required": ["grid_full"]}
    },
    "artifact": {
      "type": "object",
      "required": ["content_hash"],
      "properties": {"content_hash": {"type": "string", "pattern": "^sha256:"}}
    },
    "outcome": {
      "type": "object",
      "required": ["verdict", "evades", "payload"],
      "properties": {
        "verdict": {"enum": ["log", "flag", "quarantine", "fail_run"]},
        "evades": {
          "type": "object",
          "required": ["triage", "quarantine", "fail_run"],
          "additionalProperties": {"type": "boolean"}
        },
        "payload": {
          "type": "object",
          "required": ["bits"],
          "properties": {"bits": {"type": "number", "minimum": 0}}
        },
        "equated_with_collusion": {"const": false}
      }
    },
    "status": {"enum": ["visible", "pending", "hidden"]},
    "moderation": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["action", "at"],
        "properties": {"action": {"enum": ["approve", "hide"]}}
      }
    },
    "equated_with_collusion": {"const": false}
  }
}
