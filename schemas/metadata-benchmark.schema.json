{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://covertlens.internal/schemas/metadata-benchmark.schema.json",
  "title": "CovertLens metadata benchmark report (CL-23)",
  "type": "object",
  "required": [
    "schema", "schema_version", "benchmark_version", "detector",
    "thresholds_status", "fixture_count", "skipped_non_metadata",
    "positive_count", "negative_count", "roc_auc", "rows",
    "by_payload_band", "sweep", "limitations"
  ],
  "properties": {
    "schema": {"const": "covertlens.metadata-benchmark"},
    "schema_version": {"type": "integer", "minimum": 1},
    "benchmark_version": {"type": "string", "minLength": 1},
    "detector": {
      "type": "object",
      "required": ["family", "name", "version", "config"],
      "properties": {
        "family": {"const": "metadata"},
        "name": {"type": "string", "minLength": 1},
        "version": {"type": "string", "minLength": 1},
        "config": {"type": "object", "required": ["version"]}
      }
    },
    "thresholds_status": {"const": "unfrozen_placeholder"},
    "fixture_count": {"type": "integer", "minimum": 0},
    "skipped_non_metadata": {"type": "integer", "minimum": 0},
    "positive_count": {"type": "integer", "minimum": 0},
    "negative_count": {"type": "integer", "minimum": 0},
    "roc_auc": {
      "type": "object",
      "required": ["estimate"],
      "properties": {"estimate": {"type": ["number", "null"], "minimum": 0, "maximum": 1}}
    },
    "rows": {"type": "array", "items": {"type": "object"}},
    "by_payload_band": {
      "type": "object",
      "required": ["none", "low", "medium", "high"]
    },
    "sweep": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["threshold", "tp", "fp", "tn", "fn", "precision", "recall", "false_positive_rate"]
      }
    },
    "limitations": {"type": "array", "items": {"type": "string"}}
  }
}
