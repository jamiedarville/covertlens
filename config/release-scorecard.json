{
  "decision": {
    "decision_owner": "MVP release owner",
    "limitations": [
      "Detection coverage is limited to calibrated payload bands (low/medium) and densities on gradient_noise covers; the high band rests on 1-2 held-out positives per family.",
      "Clean smooth/blocks covers fall outside the stability claim (smooth clean PNGs false-fail; blocks JPEGs occasionally withhold).",
      "JPEG latency misses the 2 s proposal at >=~1 MP and at concurrency 4; the 20 MP JPEG envelope is unmeasured.",
      "Adaptive reduced-rate, larger-image, blocks-cover and allowed-keyword-metadata attempts evade enforcement (CL-34); allowed-keyword evasion needs a policy change.",
      "Held-out samples are tiny: targets are met on point estimates with wide Wilson intervals (CL-28).",
      "R-06 preview derivatives have no dedicated gate API; derivative enforcement is procedural (CL-32).",
      "Context/sequence evidence is a triage aid only: combined scoring dilutes image evidence (CL-31).",
      "The geometric family has frozen synthetic-scene points (CL-54): quantization alone permits delivery, structure claims rest on declared codes only, and no general geometric coverage is claimed from any single subfamily."
    ],
    "rationale": [
      "Frozen enforcement is correct where claimed: gate, trace, export and prevention invariants hold with zero unauthorized serves and zero blocked transfers.",
      "Detection targets are met only inside narrowed, measured coverage; the misses (JPEG latency, low-density/adaptive evasion, low-texture covers) are documented with target revisions rather than waived.",
      "An unqualified release would overstate the evidence; no-release would discard a working, auditable enforcement core."
    ],
    "recorded_in": "CL-35 (this scorecard) and the CL-35 Jira decision comment",
    "target_revisions": [
      {
        "reason": "CL-28 probes: clean smooth PNGs false-fail, blocks JPEGs occasionally withhold.",
        "revision": "Scoped to gradient_noise covers; low-texture covers need detector recalibration first.",
        "target": "Clean-run false failures <=1% (universal covers)"
      },
      {
        "reason": "CL-29 measurements: large/concurrent JPEG reaches the explicit 2 s deadline.",
        "revision": "Holds for PNG (incl. 20 MP) and JPEG up to medium sequential; JPEG >=1 MP and the 20 MP JPEG envelope deferred pending a faster JPEG path or a re-frozen runtime limit.",
        "target": "P95 <=2 s for <=10 MB/20 MP at concurrency 4"
      },
      {
        "reason": "CL-28 held-out is high-band only; CL-34 adaptive/larger-image probes evade.",
        "revision": "Claimed only within calibrated bands and suite-like payload densities; reduced-rate and larger-image attempts are out of claim.",
        "target": ">=95% recall per family"
      },
      {
        "reason": "CL-34 adaptive probe scores 0 under Description/Title keywords (CL-23 design).",
        "revision": "Declared-keyword payloads only; allowed-keyword payloads require a policy change before any enforcement claim.",
        "target": "Metadata payload detection"
      }
    ],
    "value": "release_with_limitations"
  },
  "equated_with_collusion": false,
